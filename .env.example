# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Database
# Use SQLite by default for local development.
USE_MYSQL=false
DB_NAME=ai_recipe
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# External recipe source
COOKLIKEHOC_REPO_URL=https://github.com/Gar-b-age/CookLikeHOC
COOKLIKEHOC_ZIP_URL=https://codeload.github.com/Gar-b-age/CookLikeHOC/zip/refs/heads/main
COOKLIKEHOC_REPO_PATH=external/CookLikeHOC-main

# OCR vision provider preset
# Used only before the visual-assist config is saved from the settings page.
VISION_PROVIDER_ENABLED=false
VISION_PROVIDER_PROVIDER=openai_compatible
VISION_PROVIDER_NAME=
VISION_PROVIDER_API_KEY=
VISION_PROVIDER_BASE_URL=https://api.example.com/v1
VISION_PROVIDER_MODEL=your-vision-model
VISION_PROVIDER_TIMEOUT_SECONDS=60
VISION_PROVIDER_REQUESTS_PER_MINUTE=5
VISION_PROVIDER_PROMPT=

# Daily three-meal multi-agent LLM critic
# The deterministic agents work without an API key. Enable this only if you
# want a DeepSeek/OpenAI-compatible model to review and rewrite the meal plan.
MEAL_AGENT_LLM_ENABLED=false
MEAL_AGENT_LLM_PROVIDER_NAME=DeepSeek
MEAL_AGENT_LLM_API_KEY=
MEAL_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
MEAL_AGENT_LLM_MODEL=deepseek-chat
MEAL_AGENT_LLM_TIMEOUT_SECONDS=45
MEAL_AGENT_LLM_REUSE_VISION_CONFIG=true

# Daily three-meal full-LLM multi-agent planner
# When enabled, the dashboard keeps the deterministic plan and adds a second
# plan generated by LLM expert agents plus an LLM coordinator.
MEAL_AGENT_FULL_LLM_ENABLED=false
MEAL_AGENT_FULL_LLM_PROVIDER_NAME=
MEAL_AGENT_FULL_LLM_API_KEY=
MEAL_AGENT_FULL_LLM_BASE_URL=
MEAL_AGENT_FULL_LLM_MODEL=
MEAL_AGENT_FULL_LLM_TIMEOUT_SECONDS=60
MEAL_AGENT_FULL_LLM_REUSE_MEAL_LLM_CONFIG=true
MEAL_AGENT_FULL_LLM_MAX_RECIPES=36
MEAL_AGENT_FULL_LLM_REQUESTS_PER_MINUTE=5
MEAL_AGENT_FULL_LLM_MAX_CONCURRENCY=4
MEAL_AGENT_FULL_LLM_EXPERT_CONCURRENCY=4

# 首页异步推荐：优先展示缓存，过期后在后台无感刷新。
MEAL_PLAN_BACKGROUND_REFRESH_ENABLED=true
MEAL_PLAN_BACKGROUND_REFRESH_MINUTES=240
MEAL_PLAN_BACKGROUND_ERROR_RETRY_MINUTES=30
